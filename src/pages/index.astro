---
import Layout from '../layouts/Layout.astro';

const title = "Piso en Venta Calle de Conca 13, Arrancapins Valencia | 198m² 4 Habitaciones";
const description = "Piso en venta de 198m² con 4 habitaciones en Calle de Conca 13, Arrancapins. Frente a Gran Vía, terraza y balcón, cocina office 60m². Gastos comunitarios 30€/trimestre. A 1 minuto Plaza España.";
const keywords = "piso en venta calle conca valencia, comprar piso arrancapins valencia, piso 198m2 arrancapins, vivienda 4 habitaciones valencia, piso frente gran via valencia, viviendas extramurs valencia, piso terraza balcon valencia";
---

<Layout title={title} description={description} keywords={keywords}>
  
  <!-- Header Minimalista -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-white">
    <nav class="max-w-7xl mx-auto px-8 py-6 flex items-center justify-between">
      <a href="#inicio" class="text-sm font-light tracking-[0.3em] text-black">
        CONCA 13
      </a>
      <ul class="hidden md:flex items-center space-x-12 text-xs font-light tracking-widest">
        <li><a href="#inicio" class="text-gray-600 hover:text-black transition-colors">INICIO</a></li>
        <li><a href="#detalles" class="text-gray-600 hover:text-black transition-colors">CARACTERÍSTICAS</a></li>
        <li><a href="#galeria" class="text-gray-600 hover:text-black transition-colors">GALERÍA</a></li>
        <li><a href="#plano" class="text-gray-600 hover:text-black transition-colors">PLANO</a></li>
        <li><a href="#video" class="text-gray-600 hover:text-black transition-colors">VIDEO</a></li>
        <li><a href="#especificaciones" class="text-gray-600 hover:text-black transition-colors">ESPECIFICACIONES</a></li>
        <li><a href="#ubicacion" class="text-gray-600 hover:text-black transition-colors">UBICACIÓN</a></li>
        <li><a href="#contacto" class="bg-black text-white px-6 py-3 hover:bg-gray-800 transition-colors">CONTACTO</a></li>
      </ul>
      <button id="menu-toggle" class="md:hidden text-black">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </nav>
    
    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 px-8 py-6">
      <ul class="space-y-4 text-xs font-light tracking-widest">
        <li><a href="#inicio" class="block text-gray-600">INICIO</a></li>
        <li><a href="#detalles" class="block text-gray-600">CARACTERÍSTICAS</a></li>
        <li><a href="#galeria" class="block text-gray-600">GALERÍA</a></li>
        <li><a href="#plano" class="block text-gray-600">PLANO</a></li>
        <li><a href="#video" class="block text-gray-600">VIDEO</a></li>
        <li><a href="#especificaciones" class="block text-gray-600">ESPECIFICACIONES</a></li>
        <li><a href="#ubicacion" class="block text-gray-600">UBICACIÓN</a></li>
        <li><a href="#contacto" class="block text-gray-600">CONTACTO</a></li>
      </ul>
    </div>
  </header>

  <!-- Hero Section - Fullscreen Impactante -->
  <section id="inicio" class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Imagen de fondo -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/1297814015.jpg" 
        alt="Piso en venta Calle de Conca 13 Arrancapins Valencia" 
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"></div>
    </div>

    <!-- Contenido superpuesto -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-8 py-20 md:py-32 text-center">
      <div class="space-y-8">
        <!-- Etiqueta superior -->
        <div class="inline-block">
          <span class="text-xs tracking-[0.4em] text-white/80 bg-white/10 backdrop-blur-sm px-6 py-3">
            ARRANCAPINS, VALENCIA
          </span>
        </div>

        <!-- Título principal -->
        <h1 class="text-5xl sm:text-6xl md:text-8xl lg:text-9xl font-extralight text-white mb-8 leading-[0.9] tracking-tight">
          Calle de<br/>
          <span class="font-light">Conca 13</span>
        </h1>

        <!-- Detalles clave -->
        <div class="flex items-center justify-center gap-8 md:gap-16 text-white/90 mb-12">
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-extralight mb-1">198</div>
            <div class="text-xs tracking-[0.2em]">M²</div>
          </div>
          <div class="w-px h-12 bg-white/20"></div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-extralight mb-1">4</div>
            <div class="text-xs tracking-[0.2em]">HAB</div>
          </div>
          <div class="w-px h-12 bg-white/20"></div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-extralight mb-1">2</div>
            <div class="text-xs tracking-[0.2em]">BAÑOS</div>
          </div>
        </div>

        <!-- Precio destacado -->
        <div class="mb-8 md:mb-12">
          <div class="text-4xl sm:text-5xl md:text-6xl font-extralight text-white mb-2">570.000 €</div>
          <div class="text-xs sm:text-sm text-white/60 tracking-wider">2.879 €/m² · Frente a Gran Vía</div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 pt-6 md:pt-8">
          <a 
            href="#contacto" 
            class="group relative bg-white text-black px-8 sm:px-10 py-4 sm:py-5 text-xs tracking-[0.25em] hover:bg-black hover:text-white transition-all duration-300 overflow-hidden w-full sm:w-auto text-center"
          >
            <span class="relative z-10">SOLICITAR VISITA</span>
          </a>
          <a 
            href="tel:+34602214093" 
            class="bg-transparent border border-white text-white px-8 sm:px-10 py-4 sm:py-5 text-xs tracking-[0.25em] hover:bg-white hover:text-black transition-all duration-300 w-full sm:w-auto text-center"
          >
            LLAMAR AHORA
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-10">
      <a href="#detalles" class="flex flex-col items-center text-white/60 hover:text-white transition-colors group">
        <span class="text-xs tracking-[0.3em] mb-3">SCROLL</span>
        <svg class="w-6 h-6 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Características Grid -->
  <section class="py-12 md:py-24 bg-gray-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200">
        <div class="bg-white p-6 md:p-12 text-center">
          <div class="text-3xl md:text-4xl font-light text-black mb-2 md:mb-3">198</div>
          <div class="text-[10px] md:text-xs tracking-[0.2em] text-gray-400">M² CONSTRUIDOS</div>
        </div>
        <div class="bg-white p-6 md:p-12 text-center">
          <div class="text-3xl md:text-4xl font-light text-black mb-2 md:mb-3">4</div>
          <div class="text-[10px] md:text-xs tracking-[0.2em] text-gray-400">HABITACIONES</div>
        </div>
        <div class="bg-white p-6 md:p-12 text-center">
          <div class="text-3xl md:text-4xl font-light text-black mb-2 md:mb-3">2</div>
          <div class="text-[10px] md:text-xs tracking-[0.2em] text-gray-400">BAÑOS</div>
        </div>
        <div class="bg-white p-6 md:p-12 text-center">
          <div class="text-3xl md:text-4xl font-light text-black mb-2 md:mb-3">1</div>
          <div class="text-[10px] md:text-xs tracking-[0.2em] text-gray-400">TERRAZA Y BALCÓN</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Detalles Section -->
  <section id="detalles" class="py-16 md:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="max-w-4xl mb-24">
        <p class="text-xs tracking-[0.3em] text-gray-400 mb-8">CARACTERÍSTICAS</p>
        <h2 class="text-4xl lg:text-5xl font-bold text-black mb-8 leading-tight">
          Un espacio excepcional en el corazón de Valencia
        </h2>
        <p class="text-lg text-gray-500 font-light leading-relaxed">
          Amplio piso de 198m² con 4 habitaciones ubicado frente a Gran Vía Fernando el Católico. 
          A escasos metros del metro y a un minuto de Plaza de España. Terraza y balcón con orientación sur y cocina office de 60m².
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-12">
        <div class="bg-white shadow-sm p-10">
          <div class="text-3xl font-bold tracking-[0.2em] text-gray-400 mb-6">01</div>
          <h3 class="text-2xl font-bold text-black mb-4">Terraza y Balcón</h3>
          <p class="text-sm text-gray-500 font-light leading-relaxed">
            Terraza con orientación sur a calle Conca y balcón con vistas a gran patio de manzanas. Orientación norte-sur perfecta.
          </p>
        </div>
        
        <div class="bg-white shadow-sm p-10">
          <div class="text-3xl font-bold tracking-[0.2em] text-gray-400 mb-6">02</div>
          <h3 class="text-2xl font-bold text-black mb-4">Cocina Office 60m²</h3>
          <p class="text-sm text-gray-500 font-light leading-relaxed">
            Amplia cocina office de aproximadamente 60m². Espacio ideal para reuniones familiares y vida social.
          </p>
        </div>
        
        <div class="bg-white shadow-sm p-10">
          <div class="text-3xl font-bold tracking-[0.2em] text-gray-400 mb-6">03</div>
          <h3 class="text-2xl font-bold text-black mb-4">Gastos Mínimos</h3>
          <p class="text-sm text-gray-500 font-light leading-relaxed">
            Solo 30€/trimestre. Participación en locales del edificio. Fondos siempre disponibles sin derramas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Galería Section con Modal -->
  <section id="galeria" class="py-16 md:py-32 bg-gray-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="mb-16">
        <p class="text-xs tracking-[0.3em] text-gray-400 mb-4">GALERÍA</p>
        <h2 class="text-4xl font-bold text-black">Explore el inmueble</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="relative bg-white shadow-sm overflow-hidden cursor-pointer gallery-item group" data-index="0">
          <img src="/1297814015.jpg" alt="Salón principal reformado" class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all duration-300"></div>
          <div class="absolute top-4 right-4 bg-black/80 backdrop-blur-sm text-white px-3 py-1 text-xs tracking-wider">
            1 / 4
          </div>
          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="bg-white/90 backdrop-blur-sm px-6 py-3 rounded-full">
              <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="relative bg-white shadow-sm overflow-hidden cursor-pointer gallery-item group" data-index="1">
          <img src="/1297814026.jpg" alt="Dormitorio principal reformado" class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all duration-300"></div>
          <div class="absolute top-4 right-4 bg-black/80 backdrop-blur-sm text-white px-3 py-1 text-xs tracking-wider">
            2 / 4
          </div>
          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="bg-white/90 backdrop-blur-sm px-6 py-3 rounded-full">
              <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="relative bg-white shadow-sm overflow-hidden cursor-pointer gallery-item group" data-index="2">
          <img src="/1297814032.jpg" alt="Cocina reformada" class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all duration-300"></div>
          <div class="absolute top-4 right-4 bg-black/80 backdrop-blur-sm text-white px-3 py-1 text-xs tracking-wider">
            3 / 4
          </div>
          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="bg-white/90 backdrop-blur-sm px-6 py-3 rounded-full">
              <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="relative bg-white shadow-sm overflow-hidden cursor-pointer gallery-item group" data-index="3">
          <img src="/1297814063.jpg" alt="Terraza piso Arrancapins" class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all duration-300"></div>
          <div class="absolute top-4 right-4 bg-black/80 backdrop-blur-sm text-white px-3 py-1 text-xs tracking-wider">
            4 / 4
          </div>
          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <div class="bg-white/90 backdrop-blur-sm px-6 py-3 rounded-full">
              <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Plano del Piso Section -->
  <section id="plano" class="py-16 md:py-32 bg-gray-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="mb-16 text-center">
        <p class="text-xs tracking-[0.3em] text-gray-400 mb-4">DISTRIBUCIÓN</p>
        <h2 class="text-4xl font-bold text-black">Plano del Inmueble</h2>
        <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
          198 m² distribuidos de forma óptima con 4 habitaciones, 2 baños completos y amplios espacios de vida
        </p>
      </div>

      <div class="max-w-6xl mx-auto">
        <div class="bg-white shadow-sm overflow-hidden">
          <img 
            src="/1297813999.jpg" 
            alt="Plano del piso - Calle Cuenca 13 Arrancapins Valencia" 
            class="w-full h-auto"
            loading="lazy"
          />
        </div>
        
        <!-- Detalles clave del plano -->
        <div class="grid md:grid-cols-4 gap-6 mt-12">
          <div class="bg-white p-6 shadow-sm text-center">
            <div class="text-3xl font-extralight text-black mb-2">198 m²</div>
            <div class="text-xs tracking-wider text-gray-500">SUPERFICIE CONSTRUIDA</div>
          </div>
          <div class="bg-white p-6 shadow-sm text-center">
            <div class="text-3xl font-extralight text-black mb-2">4</div>
            <div class="text-xs tracking-wider text-gray-500">HABITACIONES</div>
          </div>
          <div class="bg-white p-6 shadow-sm text-center">
            <div class="text-3xl font-extralight text-black mb-2">2</div>
            <div class="text-xs tracking-wider text-gray-500">BAÑOS COMPLETOS</div>
          </div>
          <div class="bg-white p-6 shadow-sm text-center">
            <div class="text-3xl font-extralight text-black mb-2">1</div>
            <div class="text-xs tracking-wider text-gray-500">TERRAZA Y BALCÓN</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Modal Lightbox -->
  <div id="lightbox-modal" class="fixed inset-0 z-[100] hidden bg-black/95 backdrop-blur-sm">
    <div class="relative w-full h-full flex items-center justify-center p-4">
      <!-- Cerrar -->
      <button id="close-modal" class="absolute top-8 right-8 text-white/80 hover:text-white transition-colors z-10">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Navegación Anterior -->
      <button id="prev-image" class="absolute left-8 top-1/2 -translate-y-1/2 text-white/80 hover:text-white transition-colors">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <!-- Imagen -->
      <div class="max-w-6xl max-h-[90vh] flex items-center justify-center">
        <img id="lightbox-image" src="" alt="" class="max-w-full max-h-[90vh] object-contain shadow-2xl" />
      </div>

      <!-- Navegación Siguiente -->
      <button id="next-image" class="absolute right-8 top-1/2 -translate-y-1/2 text-white/80 hover:text-white transition-colors">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <!-- Contador -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/80 text-sm tracking-wider">
        <span id="current-image">1</span> / <span id="total-images">12</span>
      </div>
    </div>
  </div>

  <!-- Video Tour Section -->
  <section id="video" class="py-16 md:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="mb-16 text-center">
        <p class="text-xs tracking-[0.3em] text-gray-400 mb-4">VIDEO TOUR</p>
        <h2 class="text-4xl font-bold text-black">Recorrido Virtual</h2>
      </div>

      <div class="max-w-5xl mx-auto">
        <div class="bg-white shadow-sm overflow-hidden aspect-video">
          <video 
            controls 
            class="w-full h-full object-cover"
            poster="/1297813862.jpg"
          >
            <source src="https://st3v.idealista.com/cc/a1/14/hd_1387613350.mp4" type="video/mp4">
            Tu navegador no soporta la reproducción de video.
          </video>
        </div>
        <p class="text-sm text-gray-500 font-light text-center mt-6">
          Recorra el inmueble desde la comodidad de su hogar
        </p>
      </div>
    </div>
  </section>

  <!-- Especificaciones -->
  <section id="especificaciones" class="py-12 md:py-24 bg-gray-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="bg-white shadow-sm p-6 sm:p-10 md:p-16">
        <h3 class="text-2xl font-light text-black mb-12 tracking-wide">Especificaciones</h3>
        <div class="grid md:grid-cols-2 gap-x-20 gap-y-6">
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Dirección</span>
            <span class="text-sm text-black">Calle de Conca 13, 4ª</span>
          </div>
          
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Superficie construida</span>
            <span class="text-sm text-black">198 m²</span>
          </div>
          
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Superficie útil</span>
            <span class="text-sm text-black">182 m²</span>
          </div>
          
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Habitaciones</span>
            <span class="text-sm text-black">4</span>
          </div>
          
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Baños</span>
            <span class="text-sm text-black">2</span>
          </div>
          
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Terraza y balcón</span>
            <span class="text-sm text-black">Sí</span>
          </div>
          
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Planta</span>
            <span class="text-sm text-black">4ª con ascensor</span>
          </div>
          
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Orientación</span>
            <span class="text-sm text-black">Norte-Sur</span>
          </div>
          
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Gastos comunitarios</span>
            <span class="text-sm text-black">30 €/trimestre</span>
          </div>
          
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Armarios empotrados</span>
            <span class="text-sm text-black">Sí</span>
          </div>
          
          <div class="flex justify-between items-center py-5 border-b border-gray-100">
            <span class="text-sm text-gray-400 tracking-wider">Doble entrada</span>
            <span class="text-sm text-black">Sí</span>
          </div>
        </div>
      </div>
