---
import Layout from '../layouts/Layout.astro';

const title = "Piso en Venta Calle de Conca 13, Arrancapins Valencia | 198m² 7 Habitaciones";
const description = "Piso en venta de 198m² con 7 habitaciones en Calle de Conca 13, Arrancapins. Frente a Gran Vía, 2 terrazas, cocina office 60m². Gastos comunitarios 30€/trimestre. A 1 minuto Plaza España.";
const keywords = "piso en venta calle conca valencia, comprar piso arrancapins valencia, piso 198m2 arrancapins, vivienda 7 habitaciones valencia, piso frente gran via valencia, viviendas extramurs valencia, piso dos terrazas valencia";
---

<Layout title={title} description={description} keywords={keywords}>
  
  <!-- Header Minimalista -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-white">
    <nav class="max-w-7xl mx-auto px-8 py-6 flex items-center justify-between">
      <a href="#inicio" class="text-sm font-light tracking-[0.3em] text-black">
        CONCA 13
      </a>
      <ul class="hidden md:flex items-center space-x-12 text-xs font-light tracking-widest">
        <li><a href="#inicio" class="text-gray-600 hover:text-black transition-colors">INICIO</a></li>
        <li><a href="#detalles" class="text-gray-600 hover:text-black transition-colors">DETALLES</a></li>
        <li><a href="#galeria" class="text-gray-600 hover:text-black transition-colors">GALERÍA</a></li>
        <li><a href="#ubicacion" class="text-gray-600 hover:text-black transition-colors">UBICACIÓN</a></li>
        <li><a href="#contacto" class="bg-black text-white px-6 py-3 hover:bg-gray-800 transition-colors">CONTACTO</a></li>
      </ul>
      <button id="menu-toggle" class="md:hidden text-black">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </nav>
    
    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 px-8 py-6">
      <ul class="space-y-4 text-xs font-light tracking-widest">
        <li><a href="#inicio" class="block text-gray-600">INICIO</a></li>
        <li><a href="#detalles" class="block text-gray-600">DETALLES</a></li>
        <li><a href="#galeria" class="block text-gray-600">GALERÍA</a></li>
        <li><a href="#ubicacion" class="block text-gray-600">UBICACIÓN</a></li>
        <li><a href="#contacto" class="block text-gray-600">CONTACTO</a></li>
      </ul>
    </div>
  </header>

  <!-- Hero Section - Fullscreen Impactante -->
  <section id="inicio" class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Imagen de fondo -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/1297813862.jpg" 
        alt="Piso en venta Calle de Conca 13 Arrancapins Valencia" 
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"></div>
    </div>

    <!-- Contenido superpuesto -->
    <div class="relative z-10 max-w-7xl mx-auto px-8 py-32 text-center">
      <div class="space-y-8">
        <!-- Etiqueta superior -->
        <div class="inline-block">
          <span class="text-xs tracking-[0.4em] text-white/80 bg-white/10 backdrop-blur-sm px-6 py-3">
            ARRANCAPINS, VALENCIA
          </span>
        </div>

        <!-- Título principal -->
        <h1 class="text-6xl md:text-8xl lg:text-9xl font-extralight text-white mb-8 leading-[0.9] tracking-tight">
          Calle de<br/>
          <span class="font-light">Conca 13</span>
        </h1>

        <!-- Detalles clave -->
        <div class="flex items-center justify-center gap-8 md:gap-16 text-white/90 mb-12">
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-extralight mb-1">198</div>
            <div class="text-xs tracking-[0.2em]">M²</div>
          </div>
          <div class="w-px h-12 bg-white/20"></div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-extralight mb-1">7</div>
            <div class="text-xs tracking-[0.2em]">HAB</div>
          </div>
          <div class="w-px h-12 bg-white/20"></div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-extralight mb-1">2</div>
            <div class="text-xs tracking-[0.2em]">BAÑOS</div>
          </div>
        </div>

        <!-- Precio destacado -->
        <div class="mb-12">
          <div class="text-5xl md:text-6xl font-extralight text-white mb-2">570.000 €</div>
          <div class="text-sm text-white/60 tracking-wider">2.879 €/m² · Frente a Gran Vía</div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-8">
          <a 
            href="#contacto" 
