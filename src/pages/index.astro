      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-10">
      <a href="#detalles" class="flex flex-col items-center text-white/60 hover:text-white transition-colors group">
        <span class="text-xs tracking-[0.3em] mb-3">SCROLL</span>
        <svg class="w-6 h-6 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Características Grid -->
  <section class="py-24 bg-gray-bg">
