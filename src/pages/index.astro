          <div class="text-xs tracking-[0.2em] text-gray-400 mb-6">03</div>
          <h3 class="text-xl font-light text-black mb-4">Gastos Mínimos</h3>
          <p class="text-sm text-gray-500 font-light leading-relaxed">
            Solo 30€/trimestre. Participación en locales del edificio. Fondos siempre disponibles sin derramas.
          </p>
        </div>
      </div>
    </div>
  </section>

